# direnv loads this automatically when you cd into the directory, and unloads
# it when you leave. Run `direnv allow` once to trust it.
#
# It is optional: every variable here has a default in the code, so the project
# works without direnv. What it buys is that your shell, your editor's terminal
# and `make run` all see the same configuration - which is where "works on my
# machine" usually comes from.
#
# Never put a real secret in a file that is committed. Secrets go in
# .envrc.local, which .gitignore excludes; direnv sources it from here.

export NOTES_ADDR=":8093"
export NOTES_DB="notes.db"
export NOTES_LOG_LEVEL="debug"

# Local overrides and secrets, if the file exists.
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi
